{
  "compilerOptions": {
    // File Layout
    // "rootDir": "./src",
    // "outDir": "./dist",

    // Environment Settings
    // Antes: "module": "nodenext" (exige extensiones .js en los imports relativos)
    // Ahora: ESNext + moduleResolution "bundler" acepta imports sin extensión,
    // igual que Metro en la app móvil.
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "esnext",
    "types": [],
    // "lib": ["esnext"], "types": ["node"], npm install -D @types/node

    // Other Outputs
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // Style Options (todas comentadas: noImplicitReturns, noImplicitOverride,
    // noUnusedLocals, noUnusedParameters, noFallthroughCasesInSwitch,
    // noPropertyAccessFromIndexSignature)

    // Recommended Options
    "strict": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  }
}
